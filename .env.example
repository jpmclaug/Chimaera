# ==========================================
# Chimera - MTG Market Tracker Configuration
# ==========================================

# Secret Key for Flask session security
SECRET_KEY=chimera-dev-secret-key-change-in-production

# Port for the web server (defaults to 5050)
PORT=5050

# Neon Serverless PostgreSQL Connection String
# Example: postgresql://user:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left blank, Chimera defaults to a local SQLite database (sqlite:///chimera.db) for zero-config local testing.
DATABASE_URL=

# Discord Webhook URL for Deal Alerts (Optional)
# Example: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Automatic Price Poll Interval (in hours, e.g., 6 or 12)
POLL_INTERVAL_HOURS=6

# Optional: eBay Developer API Credentials for official eBay Browse/Finding API
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
