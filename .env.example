# ==========================================
# Chimera - MTG Market Tracker Configuration
# ==========================================

# Secret Key for Flask session security
SECRET_KEY=chimera-dev-secret-key-change-in-production

# Port for the web server (defaults to 5050)
PORT=5050

# Neon Serverless PostgreSQL Connection String
# Example: postgresql://user:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left blank, Chimera defaults to a local SQLite database (sqlite:///chimera.db) for zero-config local testing.
DATABASE_URL=

# Discord Webhook URL for Deal Alerts (Optional)
# Example: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Automatic Price Poll Interval (in hours, e.g., 6 or 12)
POLL_INTERVAL_HOURS=6

# Optional: eBay Developer API Credentials for official eBay Browse/Finding API
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Best Buy Local Store Stock & Price Surveillance (Optional API Key from developer.bestbuy.com)
BESTBUY_API_KEY=
BESTBUY_POSTAL_CODE=28202
BESTBUY_SEARCH_RADIUS=25

# Optional: Gmail IMAP Auto-Fetch for TCGplayer Order Confirmation Emails
# Create a 16-character Google App Password at https://myaccount.google.com/apppasswords
GMAIL_IMAP_EMAIL=
GMAIL_IMAP_APP_PASSWORD=

# Multi-Retailer Sealed Surveillance (Shopify Global Catalog / Shop app)
# Public HTTPS URL serving Chimera's UCP agent profile (defaults to APP_BASE_URL/.well-known/ucp/agent-profile.json or Shopify's example profile)
UCP_AGENT_PROFILE_URL=
# Optional OAuth client credentials from Shopify Dev Dashboard for 5 req/s guaranteed quota (leave blank for anonymous tier)
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
# Scam price-floor threshold as a fraction of TCGplayer market price (default: 0.55 = drop offers below 55% of market)
SEALED_MIN_MARKET_RATIO=0.55

